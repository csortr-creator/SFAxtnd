diff --git a/common/urltest/sfa_probe_timeout_test.go b/common/urltest/sfa_probe_timeout_test.go
new file mode 100644
--- /dev/null
+++ b/common/urltest/sfa_probe_timeout_test.go
@@ -0,0 +1,45 @@
+package urltest
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+func TestSFAProbeTimeoutIncludesWarmRequest(t *testing.T) {
+	for _, warm := range []bool{false, true} {
+		t.Run(map[bool]string{false: "cold", true: "warm"}[warm], func(t *testing.T) {
+			calls := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls++
+				if warm && calls == 1 {
+					w.WriteHeader(204)
+					return
+				}
+				<-r.Context().Done()
+			}))
+			defer server.Close()
+			start := time.Now()
+			ctx := WithProbeTimeout(WithProbeMode(context.Background(), warm), 1000)
+			_, err := URLTest(ctx, server.URL, &probeTestDialer{})
+			if err == nil {
+				t.Fatal("stalled endpoint was accepted")
+			}
+			if elapsed := time.Since(start); elapsed < 800*time.Millisecond || elapsed > 3*time.Second {
+				t.Fatalf("timeout not applied: %s", elapsed)
+			}
+		})
+	}
+}
+func TestSFAProbeTimeoutBounds(t *testing.T) {
+	for _, value := range []int64{0, -1, 999, 60001} {
+		if ProbeTimeout(WithProbeTimeout(context.Background(), value)) != 12*time.Second {
+			t.Fatal("invalid timeout was not normalized")
+		}
+	}
+	if ProbeTimeout(WithProbeTimeout(context.Background(), 60000)) != time.Minute {
+		t.Fatal("configured timeout ignored")
+	}
+}
