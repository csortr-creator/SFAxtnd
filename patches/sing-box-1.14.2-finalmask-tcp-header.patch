diff --git a/protocol/vless/tcp_header.go b/protocol/vless/tcp_header.go
new file mode 100644
--- /dev/null
+++ b/protocol/vless/tcp_header.go
@@ -0,0 +1,82 @@
+package vless
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+func validateTCPHeader(header *option.VLESSTCPHeaderOptions) error {
+	if len(header.Clients) > 32 || len(header.Servers) > 32 {
+		return errors.New("invalid TCP header sequence count")
+	}
+	size := 0
+	for _, side := range [][]string{header.Clients, header.Servers} {
+		for _, sequence := range side {
+			size += len(sequence)
+		}
+	}
+	if size == 0 || size > 65536 {
+		return errors.New("invalid TCP header size")
+	}
+	return nil
+}
+
+// Xray header-custom alternates client writes and server reads by sequence,
+// then reads any remaining server sequences. Never expose literal headers in errors.
+func exchangeTCPHeader(ctx context.Context, conn net.Conn, header *option.VLESSTCPHeaderOptions) (err error) {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	deadline := time.Now().Add(15 * time.Second)
+	if d, ok := ctx.Deadline(); ok && d.Before(deadline) {
+		deadline = d
+	}
+	if err := conn.SetDeadline(deadline); err != nil {
+		return err
+	}
+	stop := context.AfterFunc(ctx, func() { conn.Close() })
+	defer func() {
+		stop()
+		if err != nil && ctx.Err() != nil {
+			err = ctx.Err()
+		}
+	}()
+	read := func(expected string) error {
+		data := make([]byte, len(expected))
+		if _, err := io.ReadFull(conn, data); err != nil {
+			return errors.New("TCP header response incomplete")
+		}
+		if !bytes.Equal(data, []byte(expected)) {
+			return errors.New("TCP header response mismatch")
+		}
+		return nil
+	}
+	j := 0
+	for _, sequence := range header.Clients {
+		if _, err := io.Copy(conn, strings.NewReader(sequence)); err != nil {
+			return errors.New("TCP header request failed")
+		}
+		if j < len(header.Servers) {
+			if err := read(header.Servers[j]); err != nil {
+				return err
+			}
+			j++
+		}
+	}
+	for ; j < len(header.Servers); j++ {
+		if err := read(header.Servers[j]); err != nil {
+			return err
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return conn.SetDeadline(time.Time{})
+}
