diff --git a/common/tls/xray_certificate.go b/common/tls/xray_certificate.go
new file mode 100644
--- /dev/null
+++ b/common/tls/xray_certificate.go
@@ -0,0 +1,70 @@
+package tls
+
+import (
+	"crypto/sha256"
+	"crypto/subtle"
+	"crypto/x509"
+	"errors"
+	"time"
+)
+
+// Xray permits an exact leaf pin, or a pinned CA plus normal chain/name verification.
+func verifyXrayCertificate(rawCerts, pins [][]byte, names []string, serverName string, roots *x509.CertPool, clock func() time.Time) error {
+	if len(rawCerts) == 0 {
+		return errors.New("missing peer certificate")
+	}
+	certs := make([]*x509.Certificate, len(rawCerts))
+	for i, raw := range rawCerts {
+		cert, err := x509.ParseCertificate(raw)
+		if err != nil {
+			return err
+		}
+		certs[i] = cert
+	}
+	if len(pins) > 0 {
+		found := false
+		for i, cert := range certs {
+			digest := sha256.Sum256(cert.Raw)
+			for _, pin := range pins {
+				if subtle.ConstantTimeCompare(digest[:], pin) != 1 {
+					continue
+				}
+				if i == 0 {
+					return nil
+				}
+				roots = x509.NewCertPool()
+				roots.AddCert(cert)
+				found = true
+				break
+			}
+			if found {
+				break
+			}
+		}
+		if !found {
+			return errors.New("peer certificate does not match Xray SHA-256 pin")
+		}
+	}
+	if len(names) == 0 {
+		names = []string{serverName}
+	}
+	intermediates := x509.NewCertPool()
+	for _, cert := range certs[1:] {
+		intermediates.AddCert(cert)
+	}
+	now := time.Now()
+	if clock != nil {
+		now = clock()
+	}
+	var lastErr error
+	for _, name := range names {
+		if name == "" {
+			return errors.New("missing certificate verification name")
+		}
+		_, lastErr = certs[0].Verify(x509.VerifyOptions{Roots: roots, Intermediates: intermediates, DNSName: name, CurrentTime: now})
+		if lastErr == nil {
+			return nil
+		}
+	}
+	return lastErr
+}
diff --git a/common/tls/xray_certificate_test.go b/common/tls/xray_certificate_test.go
new file mode 100644
--- /dev/null
+++ b/common/tls/xray_certificate_test.go
@@ -0,0 +1,88 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	stdtls "crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"io"
+	"log"
+	"math/big"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/stretchr/testify/require"
+)
+
+func TestXrayCertificateVerificationHandshake(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	ca := &x509.Certificate{SerialNumber: big.NewInt(1), IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour)}
+	caDER, err := x509.CreateCertificate(rand.Reader, ca, ca, &key.PublicKey, key)
+	require.NoError(t, err)
+	ca, err = x509.ParseCertificate(caDER)
+	require.NoError(t, err)
+	leaf := &x509.Certificate{SerialNumber: big.NewInt(2), DNSNames: []string{"cert.example.org"}, KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour)}
+	leafDER, err := x509.CreateCertificate(rand.Reader, leaf, ca, &key.PublicKey, key)
+	require.NoError(t, err)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+	server.Config.ErrorLog = log.New(io.Discard, "", 0)
+	server.TLS = &stdtls.Config{Certificates: []stdtls.Certificate{{Certificate: [][]byte{leafDER, caDER}, PrivateKey: key}}}
+	server.StartTLS()
+	defer server.Close()
+	leafPin, caPin, wrong := sha256.Sum256(leafDER), sha256.Sum256(caDER), sha256.Sum256([]byte("wrong"))
+	for _, useUTLS := range []bool{false, true} {
+		for _, test := range []struct {
+			name        string
+			pins        [][]byte
+			names       []string
+			trusted, ok bool
+		}{
+			{"leaf-pin-self-signed", [][]byte{leafPin[:]}, nil, false, true},
+			{"wrong-pin", [][]byte{wrong[:]}, nil, false, false},
+			{"CA-pin-name", [][]byte{caPin[:]}, []string{"cert.example.org"}, false, true},
+			{"CA-pin-wrong-name", [][]byte{caPin[:]}, []string{"other.example.org"}, false, false},
+			{"verify-name-independent-SNI", nil, []string{"cert.example.org"}, true, true},
+			{"verify-name-untrusted", nil, []string{"cert.example.org"}, false, false},
+			{"verify-name-wrong", nil, []string{"other.example.org"}, true, false},
+			{"verify-name-alternatives", nil, []string{"wrong.example.org", "cert.example.org"}, true, true},
+		} {
+			t.Run(test.name+map[bool]string{false: "-go", true: "-utls"}[useUTLS], func(t *testing.T) {
+				options := option.OutboundTLSOptions{Enabled: true, ServerName: "front.example.org", XrayCertificateSHA256: test.pins, VerifyServerNames: test.names}
+				if useUTLS {
+					options.UTLS = &option.OutboundUTLSOptions{Enabled: true, Fingerprint: "chrome"}
+				}
+				if test.trusted {
+					options.Certificate = []string{string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: caDER}))}
+				}
+				config, err := NewClient(context.Background(), logger.NOP(), "front.example.org", options)
+				require.NoError(t, err)
+				config = config.Clone()
+				config.SetServerName("clone.example.org")
+				conn, err := net.DialTimeout("tcp", server.Listener.Addr().String(), time.Second)
+				require.NoError(t, err)
+				defer conn.Close()
+				require.NoError(t, conn.SetDeadline(time.Now().Add(5*time.Second)))
+				client, err := config.Client(conn)
+				require.NoError(t, err)
+				err = client.HandshakeContext(context.Background())
+				if test.ok {
+					require.NoError(t, err)
+				} else {
+					require.Error(t, err)
+				}
+			})
+		}
+	}
+}
diff --git a/transport/v2rayxhttp/concurrent_posts_test.go b/transport/v2rayxhttp/concurrent_posts_test.go
new file mode 100644
--- /dev/null
+++ b/transport/v2rayxhttp/concurrent_posts_test.go
@@ -0,0 +1,135 @@
+package v2rayxhttp
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/stretchr/testify/require"
+)
+
+type blockedPostTransport struct {
+	started  chan *http.Request
+	release  chan struct{}
+	finished chan struct{}
+	fail     bool
+}
+
+func (b *blockedPostTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	b.started <- r
+	defer func() { b.finished <- struct{}{} }()
+	select {
+	case <-b.release:
+		if b.fail {
+			return nil, errors.New("test POST failure")
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(""))}, nil
+	case <-r.Context().Done():
+		return nil, r.Context().Err()
+	}
+}
+func TestConcurrentPostsAreBoundedAndSequencePreserved(t *testing.T) {
+	for _, limit := range []int{1, 3} {
+		options := option.V2RayXHTTPOptions{Mode: "packet-up", SCMaxConcurrentPosts: limit, SCMaxEachPostBytes: option.V2RayXHTTPRange{From: 1, To: 1}, SCMinPostsIntervalMS: option.V2RayXHTTPRange{From: 1, To: 1}}
+		config, err := newConfig(options)
+		require.NoError(t, err)
+		transport := &blockedPostTransport{started: make(chan *http.Request, 10), release: make(chan struct{}), finished: make(chan struct{}, 10)}
+		manager := newXMuxManager(config.xmux, func() http.RoundTripper { return transport })
+		defer manager.Close()
+		target := &clientTarget{config: config, xmux: manager, requestURL: "http://example.org/xhttp/"}
+		writer := newPacketWriter(context.Background(), target, manager.acquireConnection(), "test")
+		defer writer.Close()
+		_, err = writer.Write([]byte("abcde"))
+		require.NoError(t, err)
+		requests := make([]*http.Request, 0, 5)
+		for i := 0; i < limit; i++ {
+			select {
+			case r := <-transport.started:
+				requests = append(requests, r)
+			case <-time.After(time.Second):
+				t.Fatal("POST concurrency was not reached")
+			}
+		}
+		select {
+		case <-transport.started:
+			t.Fatal("POST concurrency exceeded limit")
+		case <-time.After(30 * time.Millisecond):
+		}
+		close(transport.release)
+		for len(requests) < 5 {
+			select {
+			case r := <-transport.started:
+				requests = append(requests, r)
+			case <-time.After(time.Second):
+				t.Fatal("split payload remainder stalled")
+			}
+		}
+		got := map[string]string{}
+		for _, r := range requests {
+			data, err := io.ReadAll(r.Body)
+			require.NoError(t, err)
+			parts := strings.Split(strings.Trim(r.URL.Path, "/"), "/")
+			got[parts[len(parts)-1]] = string(data)
+		}
+		require.Equal(t, map[string]string{"0": "a", "1": "b", "2": "c", "3": "d", "4": "e"}, got)
+		for range 5 {
+			select {
+			case <-transport.finished:
+			case <-time.After(time.Second):
+				t.Fatal("POST worker leaked")
+			}
+		}
+	}
+}
+func TestConcurrentPostCloseAndFailureUnblockWorkers(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		config, err := newConfig(option.V2RayXHTTPOptions{Mode: "packet-up", SCMaxConcurrentPosts: 2, SCMaxEachPostBytes: option.V2RayXHTTPRange{From: 1, To: 1}, SCMinPostsIntervalMS: option.V2RayXHTTPRange{From: 1, To: 1}})
+		require.NoError(t, err)
+		transport := &blockedPostTransport{started: make(chan *http.Request, 10), release: make(chan struct{}), finished: make(chan struct{}, 10), fail: fail}
+		manager := newXMuxManager(config.xmux, func() http.RoundTripper { return transport })
+		defer manager.Close()
+		writer := newPacketWriter(context.Background(), &clientTarget{config: config, xmux: manager, requestURL: "http://example.org/xhttp/"}, manager.acquireConnection(), "test")
+		_, err = writer.Write([]byte("abc"))
+		require.NoError(t, err)
+		for range 2 {
+			select {
+			case <-transport.started:
+			case <-time.After(time.Second):
+				t.Fatal("requests did not start")
+			}
+		}
+		if fail {
+			close(transport.release)
+		} else {
+			require.NoError(t, writer.Close())
+		}
+		for range 2 {
+			select {
+			case <-transport.finished:
+			case <-time.After(time.Second):
+				t.Fatal("request not cancelled")
+			}
+		}
+		select {
+		case <-writer.closed:
+		case <-time.After(time.Second):
+			t.Fatal("writer not closed")
+		}
+		var wg sync.WaitGroup
+		wg.Add(1)
+		go func() { defer wg.Done(); _, _ = writer.Write([]byte("x")) }()
+		done := make(chan struct{})
+		go func() { wg.Wait(); close(done) }()
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Fatal("writer blocked after shutdown")
+		}
+	}
+}
