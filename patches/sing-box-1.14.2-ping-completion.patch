@@ -0,0 +1,118 @@
+package daemon
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	M "github.com/sagernet/sing/common/metadata"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type sfaProbeOutbound struct {
+	adapter.Outbound
+	entered chan struct{}
+	release chan struct{}
+	calls   atomic.Int32
+}
+
+func (o *sfaProbeOutbound) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	if o.calls.Add(1) == 1 {
+		close(o.entered)
+	}
+	select {
+	case <-o.release:
+		return nil, errors.New("test dial failure")
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+
+type sfaProbeManager struct {
+	adapter.OutboundManager
+	outbound adapter.Outbound
+}
+
+func (m sfaProbeManager) Outbound(_ string) (adapter.Outbound, bool) { return m.outbound, true }
+
+func TestSFAURLTestWaitsForCompletionAndRejectsDuplicates(t *testing.T) {
+	outbound := &sfaProbeOutbound{entered: make(chan struct{}), release: make(chan struct{})}
+	service := &StartedService{serviceStatus: &ServiceStatus{Status: ServiceStatus_STARTED}, instance: &Instance{
+		ctx: context.Background(), outboundManager: sfaProbeManager{outbound: outbound}, urlTestHistoryStorage: urltest.NewHistoryStorage(),
+	}}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := service.URLTest(ctx, &URLTestRequest{OutboundTag: "node"}); done <- err }()
+	select {
+	case <-outbound.entered:
+	case <-ctx.Done():
+		t.Fatal("test did not start")
+	}
+	select {
+	case <-done:
+		t.Fatal("RPC acknowledged before dial completed")
+	default:
+	}
+	for range 10 {
+		_, err := service.URLTest(ctx, &URLTestRequest{OutboundTag: "node"})
+		if status.Code(err) != codes.FailedPrecondition {
+			t.Fatalf("duplicate not rejected: %v", err)
+		}
+	}
+	if outbound.calls.Load() != 1 {
+		t.Fatal("duplicate tests were started")
+	}
+	close(outbound.release)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("RPC did not finish")
+	}
+	if _, err := service.URLTest(ctx, &URLTestRequest{OutboundTag: "node"}); err != nil {
+		t.Fatal(err)
+	}
+	if outbound.calls.Load() != 2 {
+		t.Fatal("failed test kept lock after completion")
+	}
+}
+
+func TestSFAURLTestStopsWithVPNSession(t *testing.T) {
+	outbound := &sfaProbeOutbound{entered: make(chan struct{}), release: make(chan struct{})}
+	session, stopSession := context.WithCancel(context.Background())
+	defer stopSession()
+	service := &StartedService{serviceStatus: &ServiceStatus{Status: ServiceStatus_STARTED}, instance: &Instance{
+		ctx: session, outboundManager: sfaProbeManager{outbound: outbound}, urlTestHistoryStorage: urltest.NewHistoryStorage(),
+	}}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := service.URLTest(ctx, &URLTestRequest{OutboundTag: "node"}); done <- err }()
+	select {
+	case <-outbound.entered:
+	case <-ctx.Done():
+		t.Fatal("probe did not start")
+	}
+	stopSession()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("expected cancellation: %v", err)
+		}
+	case <-ctx.Done():
+		t.Fatal("probe ignored VPN stop")
+	}
+	if !service.urlTestAccess.TryLock() {
+		t.Fatal("cancelled test kept request lock")
+	}
+	service.urlTestAccess.Unlock()
+}
