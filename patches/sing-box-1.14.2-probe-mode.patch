--- /dev/null
+++ b/common/urltest/sfa_probe_mode_test.go
@@ -0,0 +1,62 @@
+package urltest
+
+import (
+	"context"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+)
+
+type probeTestDialer struct{ dials atomic.Int32 }
+
+func (d *probeTestDialer) DialContext(ctx context.Context, network string, address M.Socksaddr) (net.Conn, error) {
+	d.dials.Add(1)
+	return (&net.Dialer{}).DialContext(ctx, network, address.String())
+}
+func (d *probeTestDialer) ListenPacket(ctx context.Context, address M.Socksaddr) (net.PacketConn, error) {
+	panic("unused")
+}
+
+func TestSFAProbeMode(t *testing.T) {
+	for _, warm := range []bool{false, true} {
+		t.Run(map[bool]string{false: "cold", true: "warm"}[warm], func(t *testing.T) {
+			var requests atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { requests.Add(1); w.WriteHeader(204) }))
+			defer server.Close()
+			dialer := &probeTestDialer{}
+			_, err := URLTest(WithProbeMode(context.Background(), warm), server.URL, dialer)
+			if err != nil {
+				t.Fatal(err)
+			}
+			expected := int32(1)
+			if warm {
+				expected = 2
+			}
+			if requests.Load() != expected {
+				t.Fatalf("requests=%d want=%d", requests.Load(), expected)
+			}
+			if dialer.dials.Load() != 1 {
+				t.Fatalf("warm connection was not reused: dials=%d", dialer.dials.Load())
+			}
+		})
+	}
+}
+func TestSFAWarmProbeReconnectsClosedEndpoint(t *testing.T) {
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		w.Header().Set("Connection", "close")
+		w.WriteHeader(204)
+	}))
+	defer server.Close()
+	dialer := &probeTestDialer{}
+	if _, err := URLTest(WithProbeMode(context.Background(), true), server.URL, dialer); err != nil {
+		t.Fatal(err)
+	}
+	if requests.Load() != 2 || dialer.dials.Load() != 2 {
+		t.Fatal("closed connections must be reopened")
+	}
+}
