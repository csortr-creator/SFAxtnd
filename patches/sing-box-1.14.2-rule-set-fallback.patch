diff --git a/route/rule/sfa_rule_set_fallback_test.go b/route/rule/sfa_rule_set_fallback_test.go
new file mode 100644
index 0000000..ee29f14
--- /dev/null
+++ b/route/rule/sfa_rule_set_fallback_test.go
@@ -0,0 +1,74 @@
+package rule
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/stretchr/testify/require"
+)
+
+type ruleSetTestTransport func(*http.Request) (*http.Response, error)
+
+func (f ruleSetTestTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestSFARuleSetFallbackCommitsOnlyValidDownload(t *testing.T) {
+	for _, failure := range []string{"network", "status", "invalid"} {
+		t.Run(failure, func(t *testing.T) {
+			direct, fallback := 0, 0
+			ctx := context.Background()
+			s := &RemoteRuleSet{ctx: ctx, logger: logger.NOP(), tag: "fixture", url: "https://example.org/rules.json", options: option.RuleSet{Format: C.RuleSetFormatSource}}
+			s.httpClient = &http.Client{Transport: ruleSetTestTransport(func(r *http.Request) (*http.Response, error) {
+				direct++
+				if failure == "network" {
+					return nil, io.ErrUnexpectedEOF
+				}
+				code, body := 200, "invalid"
+				if failure == "status" {
+					code = 503
+				}
+				return &http.Response{StatusCode: code, Status: "fixture", Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+			})}
+			s.fallbackClient = &http.Client{Transport: ruleSetTestTransport(func(r *http.Request) (*http.Response, error) {
+				fallback++
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"version":3,"rules":[{"domain":["example.com"]}]}`)), Request: r}, nil
+			})}
+			require.NoError(t, s.fetch(ctx, false))
+			require.Equal(t, 1, direct)
+			require.Equal(t, 1, fallback)
+			require.False(t, s.lastUpdated.IsZero())
+			require.Len(t, s.rules, 1)
+		})
+	}
+}
+
+func TestSFARuleSetDoesNotFallbackAfterCancellationOrSuccess(t *testing.T) {
+	for _, cancel := range []bool{false, true} {
+		ctx, stop := context.WithCancel(context.Background())
+		defer stop()
+		fallback := 0
+		s := &RemoteRuleSet{ctx: ctx, logger: logger.NOP(), tag: "fixture", url: "https://example.org/rules.json", options: option.RuleSet{Format: C.RuleSetFormatSource}}
+		s.httpClient = &http.Client{Transport: ruleSetTestTransport(func(r *http.Request) (*http.Response, error) {
+			if cancel {
+				stop()
+				return nil, context.Canceled
+			}
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"version":3,"rules":[]}`)), Request: r}, nil
+		})}
+		s.fallbackClient = &http.Client{Transport: ruleSetTestTransport(func(r *http.Request) (*http.Response, error) { fallback++; return nil, io.ErrUnexpectedEOF })}
+		err := s.fetch(ctx, false)
+		if cancel {
+			require.Error(t, err)
+			require.True(t, s.lastUpdated.Equal(time.Time{}))
+		} else {
+			require.NoError(t, err)
+		}
+		require.Zero(t, fallback)
+	}
+}
