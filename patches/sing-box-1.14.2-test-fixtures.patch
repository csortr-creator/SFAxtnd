+package v2rayxhttp_test
+
+import (
+	"io"
+	"net"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestInteropFixtureListenerPortsAvoidOutgoingRange(t *testing.T) {
+	seen := make(map[uint16]bool)
+	for range 64 {
+		port := interopPort(t)
+		require.GreaterOrEqual(t, int(port), 10000)
+		require.Less(t, int(port), 30000)
+		require.False(t, seen[port])
+		seen[port] = true
+	}
+}
+
+func TestInteropFixtureEchoCleanupClosesWorkers(t *testing.T) {
+	port, stop := interopEchoServer(t)
+	conn, err := net.Dial("tcp", net.JoinHostPort("127.0.0.1", strconv.Itoa(int(port))))
+	require.NoError(t, err)
+	defer conn.Close()
+	require.NoError(t, conn.SetDeadline(time.Now().Add(time.Second)))
+	_, err = conn.Write([]byte("ping"))
+	require.NoError(t, err)
+	response := make([]byte, 4)
+	_, err = io.ReadFull(conn, response)
+	require.NoError(t, err)
+	require.Equal(t, []byte("ping"), response)
+	stop()
+	_, err = conn.Read(response)
+	require.Error(t, err)
+}
