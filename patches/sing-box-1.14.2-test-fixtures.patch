+var interopPortMutex sync.Mutex
+var interopNextPort = 10000 + rand.IntN(10000)
+
+// Do not reserve a listener by briefly opening a port in the OS ephemeral
+// client range: an outgoing test connection can claim it before the inbound
+// server starts. Use distinct ports below that range, checking occupancy.
 func interopPort(t testing.TB) uint16 {
 	t.Helper()
+	interopPortMutex.Lock()
+	defer interopPortMutex.Unlock()
+	for range 20000 {
+		port := interopNextPort
+		interopNextPort++
+		if interopNextPort >= 30000 {
+			interopNextPort = 10000
+		}
+		listener, err := net.Listen("tcp", net.JoinHostPort("127.0.0.1", strconv.Itoa(port)))
+		if err != nil {
+			continue
+		}
+		_ = listener.Close()
+		return uint16(port)
+	}
+	t.Fatal("no available interop test listener port")
+	return 0
+}
