+package v2rayxhttp_test
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"testing"
+
+	"github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	"github.com/stretchr/testify/require"
+)
+
+func TestXHTTPVlessEncryptionInterop(t *testing.T) {
+	binary := requireXRayBinary(t)
+	for _, mode := range []string{"stream-one", "stream-up", "packet-up"} {
+		t.Run(mode, func(t *testing.T) {
+			certificate, key, ca := interopCertificate(t)
+			serverPort, proxyPort := interopPort(t), interopPort(t)
+			targetPort, closeTarget := interopEchoServer(t)
+			defer closeTarget()
+			credential := interopUUID(t)
+			encKey, err := ecdh.X25519().GenerateKey(rand.Reader)
+			require.NoError(t, err)
+			encode := base64.RawURLEncoding.EncodeToString
+			server := xrayOuterServerConfig("vless", serverPort, credential, certificate, key, "h2", mode)
+			inbound := server["inbounds"].([]any)[0].(map[string]any)
+			inbound["settings"].(map[string]any)["decryption"] = "mlkem768x25519plus.native.600s." + encode(encKey.Bytes())
+			startXRay(t, binary, serverPort, server)
+			outbound := interopOuterClientOutbound("vless", serverPort, credential, ca, "h2", mode)
+			outbound.Options.(*option.VLESSOutboundOptions).Encryption = "mlkem768x25519plus.native.0rtt." + encode(encKey.PublicKey().Bytes())
+			startInteropBox(t, option.Options{
+				Inbounds:  []option.Inbound{{Type: constant.TypeSOCKS, Options: &option.SocksInboundOptions{ListenOptions: interopListen(proxyPort)}}},
+				Outbounds: []option.Outbound{outbound},
+			})
+			// First exchange obtains a ticket; the second exercises 0-RTT on the same outbound.
+			interopPingPong(t, proxyPort, targetPort)
+			interopPingPong(t, proxyPort, targetPort)
+		})
+	}
+}
