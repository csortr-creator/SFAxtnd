+++ b/transport/vlessenc/interop_test.go
@@ -0,0 +1,224 @@
+package vlessenc
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdh"
+	"crypto/mlkem"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-vmess/vless"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func TestXrayInterop(t *testing.T) {
+	binary := os.Getenv("XHTTP_XRAY_BINARY")
+	if binary == "" {
+		t.Skip("set XHTTP_XRAY_BINARY for wire interoperability tests")
+	}
+	for _, kind := range []string{"x25519", "mlkem768"} {
+		for _, mode := range []string{"1rtt", "0rtt"} {
+			t.Run(kind+"/"+mode, func(t *testing.T) { testXray(t, binary, kind, mode) })
+		}
+	}
+}
+
+func testXray(t *testing.T, binary, kind, mode string) {
+	var public, private []byte
+	if kind == "x25519" {
+		key, err := ecdh.X25519().GenerateKey(rand.Reader)
+		if err != nil {
+			t.Fatal(err)
+		}
+		public = key.PublicKey().Bytes()
+		private = key.Bytes()
+	} else {
+		key, err := mlkem.GenerateKey768()
+		if err != nil {
+			t.Fatal(err)
+		}
+		public = key.EncapsulationKey().Bytes()
+		private = key.Bytes()
+	}
+	encode := base64.RawURLEncoding.EncodeToString
+	const uuid = "d342d11e-d424-4583-b36e-524ab1f0afa4"
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		for {
+			c, e := ln.Accept()
+			if e != nil {
+				return
+			}
+			go func() { defer c.Close(); io.Copy(c, c) }()
+		}
+	}()
+	reserve, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := reserve.Addr().String()
+	port := reserve.Addr().(*net.TCPAddr).Port
+	reserve.Close()
+	config := map[string]any{
+		"log":       map[string]any{"loglevel": "none"},
+		"inbounds":  []any{map[string]any{"listen": "127.0.0.1", "port": port, "protocol": "vless", "settings": map[string]any{"clients": []any{map[string]any{"id": uuid}}, "decryption": "mlkem768x25519plus.native.600s." + encode(private)}}},
+		"outbounds": []any{map[string]any{"protocol": "freedom"}},
+	}
+	data, _ := json.Marshal(config)
+	file := filepath.Join(t.TempDir(), "config.json")
+	if err = os.WriteFile(file, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command(binary, "run", "-config", file)
+	if err = cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { cmd.Process.Kill(); cmd.Wait() })
+	started := false
+	for until := time.Now().Add(5 * time.Second); time.Now().Before(until); {
+		c, e := net.DialTimeout("tcp", address, 50*time.Millisecond)
+		if e == nil {
+			c.Close()
+			started = true
+			break
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	if !started {
+		t.Fatal("Xray did not start")
+	}
+	client, err := NewClient("mlkem768x25519plus.native." + mode + "." + encode(public))
+	if err != nil {
+		t.Fatal(err)
+	}
+	destination := M.SocksaddrFromNet(ln.Addr())
+	roundtrip := func() error {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		c, e := (&net.Dialer{}).DialContext(ctx, "tcp", address)
+		if e != nil {
+			return e
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(5 * time.Second))
+		enc, e := client.Wrap(ctx, c)
+		if e != nil {
+			return e
+		}
+		vc, e := vless.NewClient(uuid, "", logger.NOP())
+		if e != nil {
+			return e
+		}
+		wrapped, e := vc.DialEarlyConn(enc, destination)
+		if e != nil {
+			return e
+		}
+		payload := bytes.Repeat([]byte("encrypted-vless-wire"), 2000)
+		// Echo is duplex, so drain while writing to exercise multiple AEAD records.
+		done := make(chan error, 1)
+		go func() { _, e := wrapped.Write(payload); done <- e }()
+		got := make([]byte, len(payload))
+		if _, e = io.ReadFull(wrapped, got); e != nil {
+			return e
+		}
+		if e = <-done; e != nil {
+			return e
+		}
+		if !bytes.Equal(payload, got) {
+			return io.ErrUnexpectedEOF
+		}
+		return nil
+	}
+	if err = roundtrip(); err != nil {
+		t.Fatal(err)
+	}
+	client.RWLock.RLock()
+	ticket := len(client.Ticket)
+	client.RWLock.RUnlock()
+	if mode == "0rtt" && ticket != 16 {
+		t.Fatal("server did not issue resumption ticket")
+	}
+	if mode == "1rtt" && ticket != 0 {
+		t.Fatal("1-RTT unexpectedly cached ticket")
+	}
+	var wg sync.WaitGroup
+	errors := make(chan error, 4)
+	for range 4 {
+		wg.Add(1)
+		go func() { defer wg.Done(); errors <- roundtrip() }()
+	}
+	wg.Wait()
+	close(errors)
+	for e := range errors {
+		if e != nil {
+			t.Fatal(e)
+		}
+	}
+}
+
+func TestRejectProfiles(t *testing.T) {
+	key := base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{1}, 32))
+	for _, v := range []string{"mlkem768x25519plus.native.0rtt.bad", "mlkem768x25519plus.random.0rtt." + key, "mlkem768x25519plus.native.2rtt." + key, "mlkem768x25519plus.native.0rtt." + key + "." + key} {
+		if _, err := NewClient(v); err == nil {
+			t.Fatal("invalid/unsupported profile accepted")
+		}
+	}
+}
+
+func TestHandshakeCancellation(t *testing.T) {
+	key, _ := ecdh.X25519().GenerateKey(rand.Reader)
+	client, err := NewClient("mlkem768x25519plus.native.1rtt." + base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, b := net.Pipe()
+	defer b.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	if _, err = client.Wrap(ctx, a); err != context.DeadlineExceeded {
+		t.Fatalf("unexpected result: %v", err)
+	}
+}
+
+func TestRejectCorruptRecord(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	c := NewCommonConn(a, true)
+	c.PeerAEAD = NewAEAD([]byte("context"), []byte("key"), true)
+	go func() { frame := make([]byte, 22); EncodeHeader(frame, 17); b.Write(frame) }()
+	if _, err := c.Read(make([]byte, 32)); err == nil {
+		t.Fatal("unauthenticated record accepted")
+	}
+}
+
+func TestRejectUnauthenticatedHandshake(t *testing.T) {
+	key, _ := ecdh.X25519().GenerateKey(rand.Reader)
+	client, err := NewClient("mlkem768x25519plus.native.1rtt." + base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, b := net.Pipe()
+	defer b.Close()
+	go func() { go io.Copy(io.Discard, b); b.Write(make([]byte, 1088+32+16)) }()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if _, err = client.Wrap(ctx, a); err == nil || err == context.DeadlineExceeded {
+		t.Fatalf("peer authentication not rejected: %v", err)
+	}
+}
