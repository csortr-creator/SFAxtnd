+package vlessenc
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"net"
+	"strings"
+	"time"
+)
+
+// NewClient accepts the native single-key profile supported by this build.
+func NewClient(value string) (*ClientInstance, error) {
+	if value == "" || value == "none" {
+		return nil, nil
+	}
+	parts := strings.Split(value, ".")
+	if len(parts) != 4 || parts[0] != "mlkem768x25519plus" || parts[1] != "native" || (parts[2] != "0rtt" && parts[2] != "1rtt") {
+		return nil, errors.New("unsupported VLESS encryption profile; supported: mlkem768x25519plus.native.0rtt/1rtt with one key")
+	}
+	key, err := base64.RawURLEncoding.Strict().DecodeString(parts[3])
+	if err != nil || (len(key) != 32 && len(key) != 1184) {
+		return nil, errors.New("invalid VLESS encryption key")
+	}
+	var seconds uint32
+	if parts[2] == "0rtt" {
+		seconds = 1
+	}
+	client := new(ClientInstance)
+	if err = client.Init([][]byte{key}, 0, seconds, ""); err != nil {
+		return nil, err
+	}
+	return client, nil
+}
+
+func (i *ClientInstance) Wrap(ctx context.Context, conn net.Conn) (net.Conn, error) {
+	handshakeCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	done := make(chan struct{})
+	stop := context.AfterFunc(handshakeCtx, func() { conn.Close(); close(done) })
+	wrapped, err := i.Handshake(conn)
+	if !stop() {
+		<-done
+	}
+	if handshakeCtx.Err() != nil {
+		err = handshakeCtx.Err()
+	}
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	return wrapped, nil
+}
