+			for index := range 32 {
+				payload := bytes.Repeat([]byte{byte(index)}, 2048)
+				_, err = connection.Write(payload)
+				require.NoError(t, err)
+				response := make([]byte, len(payload))
+				_, err = io.ReadFull(connection, response)
+				require.NoError(t, err)
