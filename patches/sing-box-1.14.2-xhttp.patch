@@ -0,0 +1,76 @@
+//go:build with_quic
+
+package v2rayxhttp_test
+
+import (
+	"crypto/sha256"
+	"encoding/pem"
+	"github.com/stretchr/testify/require"
+	"os"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+// The Android build must retain both Hysteria protocols alongside XHTTP.
+// Exercise authentication, TLS and obfuscation against a local native server.
+func TestHysteriaProtocols(t *testing.T) {
+	for _, protocol := range []string{C.TypeHysteria, C.TypeHysteria2} {
+		for _, pinned := range []bool{false, true} {
+			name := protocol
+			if pinned {
+				name += "-certificate-pin"
+			}
+			t.Run(name, func(t *testing.T) {
+				certificate, key, ca := interopCertificate(t)
+				serverPort, proxyPort := interopPort(t), interopPort(t)
+				targetPort, closeTarget := interopEchoServer(t)
+				defer closeTarget()
+				inboundTLS := option.InboundTLSOptionsContainer{TLS: &option.InboundTLSOptions{Enabled: true, ServerName: "xhttp.test", CertificatePath: certificate, KeyPath: key}}
+				outboundTLS := option.OutboundTLSOptionsContainer{TLS: &option.OutboundTLSOptions{Enabled: true, ServerName: "xhttp.test", CertificatePath: ca}}
+				if pinned {
+					content, err := os.ReadFile(certificate)
+					require.NoError(t, err)
+					block, _ := pem.Decode(content)
+					require.NotNil(t, block)
+					digest := sha256.Sum256(block.Bytes)
+					outboundTLS.TLS.CertificatePath = ""
+					outboundTLS.TLS.Insecure = true
+					outboundTLS.TLS.CertificateSHA256 = [][]byte{digest[:]}
+				}
+				server := option.Inbound{Type: protocol}
+				client := option.Outbound{Type: protocol}
+				serverAddress := option.ServerOptions{Server: "127.0.0.1", ServerPort: serverPort}
+				switch protocol {
+				case C.TypeHysteria:
+					server.Options = &option.HysteriaInboundOptions{
+						ListenOptions: interopListen(serverPort), UpMbps: 100, DownMbps: 100,
+						Obfs: "obfuscation", Users: []option.HysteriaUser{{AuthString: "user:pass+word"}},
+						InboundTLSOptionsContainer: inboundTLS,
+					}
+					client.Options = &option.HysteriaOutboundOptions{
+						ServerOptions: serverAddress, UpMbps: 100, DownMbps: 100,
+						AuthString: "user:pass+word", Obfs: "obfuscation", OutboundTLSOptionsContainer: outboundTLS,
+					}
+				case C.TypeHysteria2:
+					server.Options = &option.Hysteria2InboundOptions{
+						ListenOptions: interopListen(serverPort),
+						Obfs:          &option.Hysteria2Obfs{Type: "salamander", Password: "obfuscation"},
+						Users:         []option.Hysteria2User{{Password: "user:pass+word"}}, InboundTLSOptionsContainer: inboundTLS,
+					}
+					client.Options = &option.Hysteria2OutboundOptions{
+						ServerOptions: serverAddress, Password: "user:pass+word",
+						Obfs: &option.Hysteria2Obfs{Type: "salamander", Password: "obfuscation"}, OutboundTLSOptionsContainer: outboundTLS,
+					}
+				}
+				startInteropBox(t, option.Options{Inbounds: []option.Inbound{server}, Outbounds: []option.Outbound{{Type: C.TypeDirect}}})
+				startInteropBox(t, option.Options{
+					Inbounds:  []option.Inbound{{Type: C.TypeSOCKS, Options: &option.SocksInboundOptions{ListenOptions: interopListen(proxyPort)}}},
+					Outbounds: []option.Outbound{client},
+				})
+				interopPingPong(t, proxyPort, targetPort)
+			})
+		}
+	}
+}
