diff --git a/experimental/libbox/outbound_probe.go b/experimental/libbox/outbound_probe.go
new file mode 100644
index 0000000..2e2b309
--- /dev/null
+++ b/experimental/libbox/outbound_probe.go
@@ -0,0 +1,90 @@
+package libbox
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/service"
+)
+
+// OutboundProbe runs real protocol URL tests without a TUN, command socket,
+// API listeners, cache files or profile routing rules. Close cancels all tests.
+type OutboundProbe struct {
+	ctx      context.Context
+	cancel   context.CancelFunc
+	instance *box.Box
+	once     sync.Once
+}
+
+func NewOutboundProbe(configContent string, platformInterface PlatformInterface) (*OutboundProbe, error) {
+	ctx := baseContext(platformInterface)
+	ctx, cancel := context.WithCancel(ctx)
+	options, err := parseConfig(ctx, configContent)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	// Caller supplies an outbound-only config; enforce isolation at the native boundary.
+	options.Inbounds = nil
+	options.Endpoints = nil
+	options.Services = nil
+	options.Experimental = nil
+	options.NTP = nil
+	if options.Route == nil {
+		options.Route = &option.RouteOptions{}
+	}
+	options.Route.Rules = nil
+	options.Route.RuleSet = nil
+	options.Log = &option.LogOptions{Disabled: true}
+	if platformInterface != nil {
+		service.MustRegister[adapter.PlatformInterface](ctx, &platformInterfaceWrapper{iif: platformInterface, useProcFS: platformInterface.UseProcFS()})
+	}
+	return startOutboundProbe(ctx, cancel, options)
+}
+
+func startOutboundProbe(ctx context.Context, cancel context.CancelFunc, options option.Options) (*OutboundProbe, error) {
+	instance, err := box.New(box.Options{Context: ctx, Options: options})
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	if err = instance.Start(); err != nil {
+		cancel()
+		instance.Close()
+		return nil, err
+	}
+	return &OutboundProbe{ctx: ctx, cancel: cancel, instance: instance}, nil
+}
+
+func (p *OutboundProbe) URLTest(outboundTag string) (int32, error) {
+	return p.urlTest(outboundTag, "")
+}
+
+func (p *OutboundProbe) urlTest(outboundTag, testURL string) (int32, error) {
+	outbound, loaded := p.instance.Outbound().Outbound(outboundTag)
+	if !loaded {
+		return 0, E.New("outbound not found: ", outboundTag)
+	}
+	ctx, cancel := context.WithTimeout(p.ctx, 12*time.Second)
+	defer cancel()
+	delay, err := urltest.URLTest(ctx, testURL, outbound)
+	if err != nil {
+		return 0, err
+	}
+	if delay == 0 {
+		delay = 1
+	}
+	return int32(delay), nil
+}
+
+func (p *OutboundProbe) Close() error {
+	var err error
+	p.once.Do(func() { p.cancel(); err = p.instance.Close() })
+	return err
+}
