+
+// VerifyCertificateSHA256 pins the exact leaf certificate, not its public key.
+func VerifyCertificateSHA256(pins [][]byte, rawCerts [][]byte) error {
+	if len(rawCerts) == 0 {
+		return E.New("missing peer certificate")
+	}
+	digest := sha256.Sum256(rawCerts[0])
+	for _, pin := range pins {
+		if len(pin) == sha256.Size && subtle.ConstantTimeCompare(pin, digest[:]) == 1 {
+			return nil
+		}
+	}
+	return E.New("server certificate SHA-256 fingerprint mismatch")
+}
