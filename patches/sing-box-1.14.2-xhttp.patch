@@ -0,0 +1,120 @@
+package libbox
+
+import (
+	"context"
+	"fmt"
+	"github.com/sagernet/sing-box/protocol/group"
+	"github.com/sagernet/sing/service/filemanager"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	tun "github.com/sagernet/sing-tun"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/sagernet/sing/service"
+)
+
+type probeTestPlatform struct{ platformInterfaceStub }
+
+func (*probeTestPlatform) CreateDefaultInterfaceMonitor(logger logger.Logger) tun.DefaultInterfaceMonitor {
+	return &probeTestMonitor{}
+}
+
+type probeTestMonitor struct{ interfaceMonitorStub }
+
+func (*probeTestMonitor) Start() error { return nil }
+func (*probeTestMonitor) Close() error { return nil }
+
+func testProbe(t *testing.T, content string) *OutboundProbe {
+	t.Helper()
+	ctx, cancel := context.WithCancel(baseContext(nil))
+	ctx = filemanager.WithDefault(ctx, t.TempDir(), t.TempDir(), os.Getuid(), os.Getgid())
+	ctx = service.ContextWith[adapter.PlatformInterface](ctx, &probeTestPlatform{})
+	options, err := parseConfig(ctx, content)
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	probe, err := startOutboundProbe(ctx, cancel, options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { probe.Close() })
+	return probe
+}
+
+func TestOutboundProbeUsesSelectedProtocolAndCloses(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	defer server.Close()
+	probe := testProbe(t, `{"outbounds":[{"type":"direct","tag":"direct"}]}`)
+	delay, err := probe.urlTest("direct", server.URL)
+	if err != nil || delay < 1 {
+		t.Fatalf("URLTest = %d, %v", delay, err)
+	}
+	if _, err = probe.URLTest("missing"); err == nil {
+		t.Fatal("missing outbound must fail")
+	}
+	probe.Close()
+	probe.Close()
+	if _, err = probe.urlTest("direct", server.URL); err == nil {
+		t.Fatal("closed session must fail")
+	}
+}
+
+func TestOutboundProbeCancellationInterruptsHTTP(t *testing.T) {
+	entered := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		close(entered)
+		<-r.Context().Done()
+	}))
+	defer server.Close()
+	probe := testProbe(t, `{"outbounds":[{"type":"direct","tag":"direct"}]}`)
+	done := make(chan error, 1)
+	go func() { _, err := probe.urlTest("direct", server.URL); done <- err }()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("HTTP probe never started")
+	}
+	probe.Close()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("cancelled probe succeeded")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("probe was not cancelled")
+	}
+}
+
+func TestOfflineSelectorChoiceOverridesCachedSelection(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "cache.db")
+	config := func(force bool) string {
+		return fmt.Sprintf(`{
+ "outbounds":[{"type":"direct","tag":"a"},{"type":"direct","tag":"b"},
+ {"type":"selector","tag":"pick","outbounds":["a","b"],"default":"a","force_default":%t}],
+ "experimental":{"cache_file":{"enabled":true,"path":%q}}
+ }`, force, path)
+	}
+	first := testProbe(t, config(false))
+	outbound, _ := first.instance.Outbound().Outbound("pick")
+	if !outbound.(*group.Selector).SelectOutbound("b") {
+		t.Fatal("could not choose b")
+	}
+	first.Close()
+	cached := testProbe(t, config(false))
+	outbound, _ = cached.instance.Outbound().Outbound("pick")
+	if outbound.(*group.Selector).Now() != "b" {
+		t.Fatal("cache fixture did not persist b")
+	}
+	cached.Close()
+	offline := testProbe(t, config(true))
+	outbound, _ = offline.instance.Outbound().Outbound("pick")
+	if outbound.(*group.Selector).Now() != "a" {
+		t.Fatal("offline choice lost to cached b")
+	}
+}
